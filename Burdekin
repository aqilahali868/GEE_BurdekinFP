// 1. Open-Water Inshore-to-Offshore Reef Transect (1 km radius buffers)
var stations = ee.FeatureCollection([
  ee.Feature(ee.Geometry.Point([147.66, -19.62]).buffer(1000), {station: 'S1_Burdekin_Mouth', dist_km: 4}),
  ee.Feature(ee.Geometry.Point([146.91, -19.15]).buffer(1000), {station: 'S2_Magnetic_Island', dist_km: 88}),
  ee.Feature(ee.Geometry.Point([147.64, -18.82]).buffer(1000), {station: 'S3_Davies_Reef', dist_km: 135})
]);

var roi = ee.Geometry.Rectangle([146.70, -19.75, 147.85, -18.80]);
Map.centerObject(roi, 9);

// 2. Daily Sentinel-3 OLCI Red/Blue Turbidity Ratio (Nov 2023 - May 2024)
var s3 = ee.ImageCollection('COPERNICUS/S3/OLCI')
  .filterBounds(roi)
  .filterDate('2023-11-01', '2024-05-01')
  .select(['Oa08_radiance', 'Oa04_radiance', 'quality_flags']);

var s3TimeSeries = s3.map(function(img) {
  // Mask out land (bit 31) and bright clouds/glint (bit 27 + high red radiance)
  var qf = img.select('quality_flags');
  var notLand  = qf.bitwiseAnd(Math.pow(2, 31)).eq(0);
  var notCloud = qf.bitwiseAnd(Math.pow(2, 27)).eq(0).and(img.select('Oa08_radiance').lt(120));

  var turbRatio = img.select('Oa08_radiance')
    .divide(img.select('Oa04_radiance'))
    .updateMask(notLand.and(notCloud))
    .rename('s3_turbidity_ratio');

  var dateStr = img.date().format('YYYY-MM-dd');

  return turbRatio.reduceRegions({
    collection: stations,
    reducer: ee.Reducer.mean(),
    scale: 300
  }).map(function(feat) {
    // Map 'mean' output from reduceRegions into 's3_turbidity_ratio'
    return feat.set({
      'date': dateStr,
      's3_turbidity_ratio': feat.get('mean')
    });
  });
}).flatten().filter(ee.Filter.notNull(['s3_turbidity_ratio']));

// 3. Verify in Console BEFORE exporting (should show ~150-300+ rows)
print('Total valid observations:', s3TimeSeries.size());
print('Preview first 5 rows:', s3TimeSeries.limit(5));

